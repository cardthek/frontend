# true: use same-origin /api/v1 proxy; false: browser connects to a full backend URL.
NEXT_PUBLIC_USE_BACKEND_PROXY=true
# Server-only. On Netlify set it under Site configuration → Environment variables.
BACKEND_ORIGIN=http://localhost:4000
# Browser-visible API path. Keep /api/v1 so cookies stay same-origin via the proxy.
NEXT_PUBLIC_API_BASE_URL=/api/v1
